# See setup.md for how to obtain every key.

# --- Core Project & Naming ---
PROJECT_NAME=agent-flow-azure
PROJECT_SHORT=afa
ENVIRONMENT=dev
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2
AZURE_LOCATION_SHORT=eus2
AZURE_COMPUTE_LOCATION=westus2
RESOURCE_GROUP_NAME=rg-agent-flow-azure-dev
NAME_SUFFIX=01

# --- Foundry project + model router (decider + failover) ---
FOUNDRY_PROJECT_NAME=afa-agents
FOUNDRY_MODEL_NAME=gpt-4.1-mini
FOUNDRY_MODEL_VERSION=2025-04-14
FOUNDRY_MODEL_DEPLOYMENT=model-router
FOUNDRY_ROUTER_VERSION=2025-11-18
FOUNDRY_ROUTER_MODE=balanced
FOUNDRY_FALLBACK_MODELS=gpt-4.1-mini:2025-04-14,gpt-4.1:2025-04-14,gpt-4o:2024-11-20
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOUNDRY_EMBEDDING_VERSION=1
FOUNDRY_HARNESS_TYPE=copilot
FOUNDRY_RAI_POLICY_NAME=afa-default-rai
ENABLE_CONTENT_SAFETY=true
ENABLE_PROMPT_SHIELDS=true
MEMORY_STORE_NAME=afa-agent-memory
# 0 = APIM → Foundry project (preferred). 1 = local SDK to FOUNDRY_PROJECT_ENDPOINT (when APIM cannot reach Keycloak JWKS).
FOUNDRY_DIRECT_MI=0

# --- External MCP & tool secrets (seeded to Key Vault by install.sh) ---
GITHUB_MCP_PAT=
NVD_API_KEY=

# ServiceNow OSS MCP (Azure Container Apps host) — see setup.md
ENABLE_SERVICENOW_MCP=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Set after ./scripts/deploy_servicenow_mcp.sh
SERVICENOW_MCP_URL=
# FOUNDRY_DIRECT_MI=1 until KEYCLOAK_PUBLIC_URL is reachable from Azure APIM


# --- Web app ports ---
WEBAPP_FRONTEND_PORT=5748
WEBAPP_BACKEND_PORT=5749

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:5750
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=agent-flow
KEYCLOAK_CLIENT_ID=afa-web
KEYCLOAK_API_AUDIENCE=afa-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Entra (filled by provision) ---
ENTRA_WEB_CLIENT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=api://agent-flow-azure
ENTRA_REDIRECT_URI=http://localhost:5748/

# --- Workload Identity ---
USE_WORKLOAD_IDENTITY=true
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=
USE_COSMOS=1

# --- Generated by provision.sh / install.sh (do not invent) ---
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/afa-agents
# FOUNDRY_ENDPOINT=
# APIM_GATEWAY_URL=
# KEY_VAULT_URI=
# CONTENT_SAFETY_ENDPOINT=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# LOGIC_APP_NAME=afa-dev-logic-eus2-01
# LOGIC_APP_TRIGGER_URL=https://prod-….logic.azure.com:443/workflows/…/triggers/manual/paths/invoke?api-version=2019-05-01&sp=…&sv=1.0&sig=…
